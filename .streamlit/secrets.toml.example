# Sao chép thành .streamlit/secrets.toml rồi điền giá trị thật. KHÔNG commit secrets.toml.

[icost]
# Email luôn được cấp quyền Admin khi đăng nhập (dùng để khởi tạo hệ thống)
admin_emails = ["admin@daidung.vn"]
# Chỉ cho phép email thuộc các tên miền này (để trống [] = cho phép mọi tên miền,
# tài khoản lạ vẫn ở trạng thái "Chờ phân quyền" cho tới khi Admin cấp quyền)
allowed_domains = ["daidung.vn"]
# Đăng nhập thử bằng email không qua SSO - CHỈ bật khi phát triển trên máy local
dev_login = false

[auth]
# Phải trùng với Redirect URI đã khai báo ở UltraID và Google Cloud Console
redirect_uri = "http://localhost:8501/oauth2callback"
# Chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "doi-thanh-chuoi-ngau-nhien-dai"

[auth.ultraid]
# UltraID (OpenID Connect): lấy từ trang quản trị ứng dụng của UltraID
client_id = "ULTRAID_CLIENT_ID"
client_secret = "ULTRAID_CLIENT_SECRET"
server_metadata_url = "https://<ten-mien-ultraid>/.well-known/openid-configuration"
client_kwargs = { scope = "openid email profile" }

[auth.google]
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# Chỉ hiện tài khoản Google Workspace của công ty (tùy chọn)
client_kwargs = { prompt = "select_account", hd = "daidung.vn" }

[database]
# PostgreSQL (vd. Neon / Supabase) - dữ liệu lưu bền khi chạy trên cloud. Bỏ trống mục này = dùng SQLite data/icost.db
url = "postgresql://<user>:<mat-khau>@<host>/<ten-csdl>?sslmode=require"
